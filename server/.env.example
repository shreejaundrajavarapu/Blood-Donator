# BloodConnect Email Server — Environment Variables
# Copy this file to .env and fill in your values.

# ── Resend ────────────────────────────────────────────────────────────────────
# Obtain your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_REPLACE_WITH_YOUR_KEY

# Sender address (must be verified in your Resend account).
# During development you may use Resend's default sandbox sender:
#   onboarding@resend.dev   (delivers only to the account's owner email)
EMAIL_FROM=BloodConnect <noreply@yourdomain.com>

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
